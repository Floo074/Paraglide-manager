# Copier en .env.local et adapter. Variables lues AU BUILD par Vite (préfixe VITE_).

# true = n'appelle jamais le backend, utilise les données de démonstration (src/mocks/).
# Même à false, le site bascule automatiquement en démo si le backend ne répond pas.
VITE_USE_MOCKS=false

# Cible du proxy de développement /api (vite dev / vite preview uniquement).
VITE_API_PROXY_TARGET=http://localhost:8000

# Couche optionnelle "hotspots thermiques" KK7 (tuiles). Vide = couche indisponible.
# Licence CC BY-NC-SA, usage non commercial ; le paramètre src identifie votre site.
# VITE_KK7_TILES_URL=https://thermal.kk7.ch/tiles/thermals_all_all/{z}/{x}/{y}.png?src=localhost
# Les tuiles KK7 utilisent le schéma TMS (axe Y inversé).
# VITE_KK7_TMS=true
