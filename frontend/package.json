{
  "name": "paraglide-manager-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Paraglide Manager — interface web de planification de vols en parapente",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contract": "node scripts/check-contract.mjs",
    "e2e": "node e2e/parcours.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "^1.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
