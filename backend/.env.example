# Paraglide Manager — variables d'environnement du backend (copier en .env, jamais versionné).
# Toutes les variables sont optionnelles : sans clé, l'application fonctionne avec les sources libres
# et se replie sur les données de démonstration en cas d'échec réseau (DATA_MODE=auto).
# Noms insensibles à la casse (pydantic-settings).

# --- Mode de données -----------------------------------------------------------------------------
# auto = sources réelles avec repli automatique sur la démo en cas d'erreur (recommandé)
# live = sources réelles uniquement (une erreur de source = erreur de l'API)
# mock = fixtures + météo synthétique, aucun appel réseau
DATA_MODE=auto
# Délai HTTP par appel (s) et délai avant de retenter une source en échec (s, mode auto)
HTTP_TIMEOUT_S=5.0
LIVE_RETRY_AFTER_S=120

# --- Open-Meteo (libre, sans clé, CC-BY 4.0) -----------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# Modèles interrogés ensemble (variables suffixées par modèle dans la réponse)
OPEN_METEO_MODELS=meteofrance_arome_france_hd,icon_d2,ecmwf_ifs025
OPEN_METEO_GRID_MODEL=best_match
# Uniquement pour l'offre commerciale (customer-api.open-meteo.com) : laisser vide sinon
OPEN_METEO_API_KEY=

# --- OpenAIP (espaces aériens, clé gratuite) -----------------------------------------------------
# Compte gratuit sur https://www.openaip.net → profil → « API clients » → créer une clé.
# Envoyée dans l'en-tête x-openaip-api-key, jamais dans l'URL ni dans les logs.
OPENAIP_API_KEY=
OPENAIP_URL=https://api.core.openaip.net/api

# --- Fichiers OpenAir locaux (repli sans clé pour les espaces aériens) ---------------------------
# Dossier contenant des fichiers .txt / .air / .openair (voir data/airspaces/README.md).
# Défaut : backend/data/airspaces (chemin absolu calculé). Un chemin relatif l'est au dossier courant.
# AIRSPACE_OPENAIR_DIR=/chemin/vers/openair

# --- ParaglidingEarth (sites, libre) : https://www. obligatoire ----------------------------------
PARAGLIDINGEARTH_URL=https://www.paraglidingearth.com/api/geojson

# --- Pioupiou / OpenWindMap (balises, libre) -----------------------------------------------------
PIOUPIOU_URL=https://api.pioupiou.fr/v1/live/all

# --- Biodiv'Sports (zones sensibles faune, libre) ------------------------------------------------
BIODIVSPORTS_URL=https://biodiv-sports.fr/api/v2

# --- FFVL (sites et balises, clé à demander à la FFVL) -------------------------------------------
FFVL_API_KEY=
FFVL_API_URL=https://data.ffvl.fr/api

# --- SpotAir / Météo-Parapente : pas d'API publique, accord nécessaire (aucun scraping) -----------
SPOTAIR_API_URL=
SPOTAIR_API_KEY=
METEO_PARAPENTE_API_URL=
METEO_PARAPENTE_API_KEY=

# --- Caches mémoire (secondes) -------------------------------------------------------------------
CACHE_TTL_FORECAST_S=1800
CACHE_TTL_SITES_S=86400
CACHE_TTL_BEACONS_S=120
CACHE_TTL_PLANS_S=21600
CACHE_TTL_AIRSPACES_S=86400
CACHE_TTL_SENSITIVE_S=86400
CACHE_TTL_ELEVATION_S=604800

# --- Météo synthétique (DATA_MODE=mock) ----------------------------------------------------------
# Force un scénario pour toutes les dates (ex. thermal_good, afternoon_storms) ; vide = cycle auto
SYNTHETIC_SCENARIO=

# --- Serveur -------------------------------------------------------------------------------------
# Liste JSON des origines autorisées (CORS)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
